# Copy to .env.local and fill in. All optional.

# Public URL of the deployed site (used for canonical URLs, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=https://www.pushpamjewellers.example

# Formspree form id (https://formspree.io). If empty, forms fall back to WhatsApp.
NEXT_PUBLIC_FORMSPREE_ID=

# Optional live gold-rate endpoint. Must return JSON matching RateSnapshot
# (see lib/rates.ts). If empty, content/rates.json is used.
NEXT_PUBLIC_RATES_API_URL=
